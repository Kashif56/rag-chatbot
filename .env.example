# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-railway-app.up.railway.app,your-custom-domain.com

# Database Settings
# Railway will provide this automatically, but you can set it manually if needed
# DATABASE_URL=postgres://username:password@hostname:port/database_name

# Pinecone Settings
PINECONE_API_KEY=your-pinecone-api-key

# Email Settings for OTP Verification
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@nexusai.com

# Add any other environment variables your application needs
